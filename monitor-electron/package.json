{
  "name": "phobias-adaptive-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Electron monitor for VR Phobia EEG (WebSocket to aura_recorder)",
  "main": "./bootstrap.cjs",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "package:mac": "electron-builder --mac --dir",
    "package:win": "electron-builder --win",
    "package:standalone:mac": "electron-builder --mac",
    "package:standalone:win": "electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "jp.mirai.vr-phobia-monitor",
    "productName": "VR Phobia Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "bootstrap.cjs",
      "out/**/*",
      "package.json",
      "node_modules/selfsigned/**/*",
      "node_modules/ws/**/*"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ws/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VR-Phobia-Lab-${version}-portable.exe"
    },
    "dmg": {
      "title": "VR Phobia Lab"
    }
  }
}
