{
  "name": "vr-atr-phobias",
  "private": true,
  "scripts": {
    "serve": "node server-https.js",
    "cert": "node generate-cert.js",
    "serve:http": "npx --yes http-server -p 8080 -c-1",
    "serve:https": "npx --yes http-server app -p 8443 -S -c-1",
    "postinstall": "npm install --prefix monitor-electron",
    "monitor": "npm run dev --prefix monitor-electron -- -- --wss",
    "monitor:tk": "python3 scripts/adaptive_monitor_gui.py --wss",
    "experiment": "npx --yes concurrently -n web,recorder,monitor -c blue,green,magenta \"npm run serve:https\" \"python3 scripts/aura_recorder.py --wss\" \"npm run monitor\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "http-server": "^14.1.1",
    "selfsigned": "^2.4.1"
  }
}
